# ===== 面试官 LLM（OpenAI 兼容端点）=====
TEXT_MODEL_BASE_URL=https://api.minimaxi.com/v1
TEXT_MODEL=MiniMax-M3
TEXT_MODEL_API_KEY=sk-xxx

# ===== JEV 测评引擎（Decisions API）=====
TYPESAFE_BASE_URL=https://openrouter.ai/api/alpha/decisions
TYPESAFE_MODEL=~typesafe/jev-latest
TYPESAFE_API_KEY=sk-or-v1-xxx

# ===== 可选：置信度门控阈值 =====
# 实测口径：score 维度置信度均值 ≈0.55-0.95；choice 四选一 ≈0.41-0.55
CONFIDENCE_FLOOR=0.45
BAND_CONFIDENCE_FLOOR=0.30

# ===== 可选：追问与提示 =====
MAX_FOLLOWUPS=3        # 整场追问上限
SHORT_ANSWER_CHARS=15  # 低于此字数打分卡标注"回答偏短"
